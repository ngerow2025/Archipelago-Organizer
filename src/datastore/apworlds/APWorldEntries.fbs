namespace serialization;

enum LocalSourceType: byte {
    APWorldFile,
    Directory,
    NotLocal,
}

enum RemoteSourceType: byte {
    GithubRelease,
    ArchipelagoMWGithub,
    NotRemote,
}


table APWorldEntry {
    major_version: int;
    minor_version: int;
    patch_version: int;
    game: string;
    remote_url: string;
    local_path: string;
    local_source_type: LocalSourceType;
    remote_source_type: RemoteSourceType;
}

table GithubSource {
    owner: string;
    repo: string;
    game_name: string;
}

table APWorldMetadata { 
    entries: [APWorldEntry];
    github_sources: [GithubSource];
}

root_type APWorldMetadata;